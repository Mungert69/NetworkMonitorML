<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <Nullable>enable</Nullable>

    <!-- Containerization -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerImageTag>0.6.0</ContainerImageTag>
    <ContainerImageFormat>OCI</ContainerImageFormat>

    <!-- Framework-dependent container base (console app) -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>

    <!-- Default RIDs; MKL is gated to x64 to avoid shipping wrong native bits -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>

    <RollForward>Minor</RollForward>
    <StartupObject>NetworkMonitor.ML.Program</StartupObject>
    <Optimize Condition="'$(Publishing)' == 'true'">true</Optimize>
    <Optimize Condition="'$(Publishing)' != 'true'">false</Optimize>
    <!-- ML.NET hard-codes x86/x64 in its build check; allow arm64 builds -->
    <EnableMLUnsupportedPlatformTargetCheck Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">false</EnableMLUnsupportedPlatformTargetCheck>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release-Dev'">
    <DefineConstants>DEV</DefineConstants>
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitorpredict-dev</ContainerRepository>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitorpredict</ContainerRepository>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="4.0.3" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="4.0.3" />
    <PackageReference Include="MKL.NET.linux-x64" Version="2022.0.1.117" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="TensorFlow.NET" Version="0.150.0" />
     <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.5" />

  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorData\NetworkMonitorData.csproj" />
  </ItemGroup>

</Project>
